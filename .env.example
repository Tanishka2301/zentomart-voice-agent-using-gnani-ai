# Copy this file to .env and fill in your own local credentials.
# Never commit .env or real API keys.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GNANI_API_KEY=your_gnani_api_key_here
# Absolute path to the extracted Capstone_Project_Dataset_FTTT_2026 directory
ZENTOMART_DATA_DIR=/absolute/path/to/Capstone_Project_Dataset_FTTT_2026
